# ==============================================================================
# PLATAFORMA IAProfEPT — Variáveis de Ambiente
# Produto Educacional (PTT4) / Tese de Doutorado PPGEM-UFJF
# ==============================================================================

# --- CONFIGURAÇÃO DO SERVIDOR ---
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# --- BANCO DE DADOS POSTGRESQL 16+ ---
# Opção 1: Conexão via URL Completa
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iaprofept_db?sslmode=disable

# Opção 2: Parâmetros Individuais
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=iaprofept_db

# Parâmetros do Pool de Conexões (PostgreSQL 16+)
PG_MAX_POOL=20
PG_MIN_POOL=2
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=5000

# Configuração de SSL (disable | require | verify-full)
PGSSLMODE=disable
PGSSL_REJECT_UNAUTHORIZED=false
# PGSSL_CA=/caminho/para/certificado_institucional_ufjf.crt

# Codificação de Caracteres (Obrigatório UTF-8)
PGCLIENTENCODING=UTF8
DEBUG_SQL=false

# --- AUTENTICAÇÃO E SEGURANÇA (JWT) ---
JWT_SECRET=chave_secreta_super_segura_iaprofept_ufjf_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=chave_refresh_super_segura_iaprofept_ufjf_2026
JWT_REFRESH_EXPIRES_IN=7d

# --- MOTORES DE INTELIGÊNCIA ARTIFICIAL (TESTE A/B) ---
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui

# Telemetria A/B (groq | gemini | auto)
AI_ENGINE_DEFAULT=auto
